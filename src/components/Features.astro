---
import Section from "./ui/Section.astro";
import Icon from "./ui/Icon.astro";
import { features } from "../data/site";
---

<Section labelledby="features-title">
  <div class="features">
    <div class="section-head section-head--left features__head">
      <p class="eyebrow">Por qué SEIKET</p>
      <h2 id="features-title">No solo limpiamos: protegemos tus activos</h2>
      <p class="lead">
        Al ofrecer limpieza aeronáutica y de paneles solares, nos posicionamos en el nicho
        de servicios técnicos que exigen protocolos estrictos y capacitación avanzada.
      </p>
    </div>

    <ul class="features__list">
      {
        features.map((feature) => (
          <li class="feature">
            <span class="icon-badge">
              <Icon name={feature.icon} size={24} />
            </span>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .features {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .features__head {
    margin-bottom: 0;
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }

  .features__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-5);
  }

  .feature {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .feature .icon-badge {
    width: 2.75rem;
    height: 2.75rem;
  }

  .feature h3 {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
  }

  .feature p {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .features {
      grid-template-columns: 1fr;
    }

    .features__head {
      position: static;
    }
  }
</style>
