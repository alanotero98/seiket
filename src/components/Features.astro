---
import Section from "./ui/Section.astro";
import Icon from "./ui/Icon.astro";
import { features } from "../data/site";
---

<Section labelledby="features-title">
  <div class="features" data-features-reveal>
    <div class="section-head section-head--left features__head" data-features-head>
      <p class="eyebrow">Por qué SEIKET</p>
      <h2 id="features-title">No solo limpiamos: protegemos tus activos</h2>
      <p class="lead">
        Al ofrecer limpieza aeronáutica y de paneles solares, nos posicionamos en el nicho
        de servicios técnicos que exigen protocolos estrictos y capacitación avanzada.
      </p>
    </div>

    <ul class="features__list">
      {
        features.map((feature, index) => (
          <li class="feature" style={`--reveal-index: ${index + 1}`}>
            <span class="icon-badge">
              <Icon name={feature.icon} size={24} />
            </span>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<script>
  // Aparición progresiva al hacer scroll. Sin JS (o con movimiento reducido)
  // el contenido queda visible tal como está en el HTML.
  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const root = document.querySelector<HTMLElement>("[data-features-reveal]");

  if (root && !prefersReducedMotion() && "IntersectionObserver" in window) {
    const head = root.querySelector<HTMLElement>("[data-features-head]");
    const items = Array.from(root.querySelectorAll<HTMLElement>(".feature"));
    const targets = head ? [head, ...items] : items;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
    );

    // El estado inicial (opacity 0 + desplazamiento) se aplica recién cuando el
    // observer está listo, para que un fallo de JS no oculte el contenido.
    root.setAttribute("data-reveal-ready", "");
    for (const target of targets) observer.observe(target);
  }
</script>

<style>
  .features {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .features__head {
    margin-bottom: 0;
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }

  .features__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-5);
  }

  .feature {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .feature .icon-badge {
    width: 2.75rem;
    height: 2.75rem;
  }

  .feature h3 {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
  }

  .feature p {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ----------------------------------------------------------------------
     Aparición progresiva al hacer scroll.
     Sólo se aplica si el script activó data-reveal-ready: sin JS el
     contenido permanece visible.
     ---------------------------------------------------------------------- */
  .features[data-reveal-ready] .features__head,
  .features[data-reveal-ready] .feature {
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 550ms var(--ease),
      transform 550ms var(--ease);
    transition-delay: calc(var(--reveal-index, 0) * 120ms);
  }

  .features[data-reveal-ready] :is(.features__head, .feature).is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .features[data-reveal-ready] .features__head,
    .features[data-reveal-ready] .feature {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .features {
      grid-template-columns: 1fr;
    }

    .features__head {
      position: static;
    }
  }
</style>
