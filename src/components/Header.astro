---
import { Image } from "astro:assets";
import logo from "../assets/Logo_77778.png";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import { nav } from "../data/site";
---

<header class="site-header" id="inicio" data-header>
  <div class="container header__inner">
    <a class="header__brand" href="#inicio" aria-label="SEIKET Facility Services — inicio">
      <Image
        src={logo}
        alt=""
        class="header__logo"
        height={80}
        format="webp"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav id="primary-nav" class="nav" aria-label="Navegación principal">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a class="nav__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__mobile-cta">
        <Button href="#contacto" icon="arrow-right" class="btn--block">Solicitar propuesta</Button>
      </div>
    </nav>

    <div class="header__actions">
      <Button href="#contacto" icon="arrow-right" class="header__cta">Solicitar propuesta</Button>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Abrir menú de navegación"
        data-nav-toggle
      >
        <span class="nav-toggle__icon nav-toggle__icon--open"><Icon name="menu" size={26} /></span>
        <span class="nav-toggle__icon nav-toggle__icon--close"><Icon name="close" size={26} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      background-color var(--transition);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
    background-color: rgba(255, 255, 255, 0.97);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-height);
    padding-top: 0;
    padding-bottom: 0;
  }

  /* El PNG ya viene recortado a la banda visible de la marca (2112x398),
     sin padding transparente. Se muestra a su proporción natural, con una
     altura proporcional al header para conservar el tamaño anterior. */
  .header__brand {
    display: inline-flex;
    align-items: center;
    height: 100%;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .header__logo {
    display: block;
    height: calc(var(--header-height) * 0.57);
    width: auto;
    max-width: 100%;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav__link {
    display: inline-block;
    padding: 0.55rem 0.7rem;
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    color: var(--ink-700);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition:
      color var(--transition),
      background-color var(--transition);
    white-space: nowrap;
  }

  .nav__link:hover {
    color: var(--color-primary);
    background-color: var(--brand-50);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav__mobile-cta {
    display: none;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--brand-800);
  }

  .nav-toggle__icon {
    display: inline-flex;
  }

  .nav-toggle__icon--close {
    display: none;
  }

  @media (max-width: 1040px) {
    :global(.btn.header__cta) {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .nav {
      position: fixed;
      inset: var(--header-height) 0 auto 0;
      display: none;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-5);
      background: var(--white);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
    }

    .site-header[data-open] .nav {
      display: flex;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-1);
    }

    .nav__link {
      padding: 0.85rem 0.75rem;
      border-radius: var(--radius-md);
      font-size: var(--text-lg);
    }

    .nav__mobile-cta {
      display: block;
    }

    .site-header[data-open] .nav-toggle__icon--open {
      display: none;
    }

    .site-header[data-open] .nav-toggle__icon--close {
      display: inline-flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.getElementById("primary-nav");

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? "Cerrar menú de navegación" : "Abrir menú de navegación",
      );
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => setOpen(!header.hasAttribute("data-open")));

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 4);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
