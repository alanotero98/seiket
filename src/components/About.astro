---
import { Image } from "astro:assets";
import Icon from "./ui/Icon.astro";
import { about } from "../data/site";
import aeronautica from "../assets/corporativo.jpg";
import cleaning from "../assets/oficina.jpg";
import paneles from "../assets/panelessolares.avif";
import industrial from "../assets/facilityservices.png";
import carrousel1 from "../assets/carrousel1.jpg";
import carrousel2 from "../assets/carrousel2.jpg";
import carrousel3 from "../assets/carrousel3.jpg";

const pilares = [
  {
    icon: "badge",
    title: "Calidad y mejora continua",
    description: "Procesos documentados.",
  },
  ...about.values,
];

// Carrusel de pilares: tres imágenes verticales que intercambian posición.
const carousel = [
  {
    src: carrousel1,
    alt: "Intervención técnica de SEIKET.",
    position: "pos-center",
  },
  {
    src: carrousel2,
    alt: "Equipo SEIKET en operación.",
    position: "pos-right",
  },
  {
    src: carrousel3,
    alt: "Trabajo técnico de SEIKET.",
    position: "pos-left",
  },
];

const gallery = [
  {
    src: aeronautica,
    alt: "Limpieza técnica del fuselaje de una aeronave.",
    tag: "Technical precision",
    variant: "a",
    class: "about__shot--a",
  },
  {
    src: cleaning,
    alt: "Limpieza industrial en fábricas y galpones.",
    tag: "Industrial cleaning",
    variant: "b",
    class: "about__shot--b",
  },
  {
    src: paneles,
    alt: "Instalación fotovoltaica de gran escala con paneles solares.",
    tag: "Energía y renovables",
    variant: "c",
    class: "about__shot--c",
  },
  {
    src: industrial,
    alt: "Interior de una nave industrial de grandes dimensiones.",
    tag: "Facility services",
    variant: "d",
    class: "about__shot--d",
  },
];
---

<section id="nosotros" class="about" data-about-reveal aria-labelledby="nosotros-title">
  <!-- Bloque superior: hero editorial sobre fondo blanco -->
  <div class="about__top">
    <div class="about__track">
      <div class="container about__stage">
      <div class="about__gallery" aria-hidden="false">
        {
          gallery.map((item, index) => (
            <figure
              class:list={["about__shot", item.class]}
              data-reveal-shot
              style={`--i: ${index}`}
            >
              <Image
                src={item.src}
                alt={item.alt}
                widths={[400, 640]}
                sizes="(max-width: 900px) 45vw, 26vw"
                loading="lazy"
                decoding="async"
                class="about__shot-img"
              />
              <figcaption class="about__shot-tag">{item.tag}</figcaption>
            </figure>
          ))
        }
      </div>

      <header class="about__intro" data-reveal-intro>
        <p class="eyebrow">Nosotros</p>
        <h2 id="nosotros-title" class="about__headline">
          Innovación que transforma <span>cada superficie</span>
        </h2>
        <p class="about__lede">
          Servicios integrales de limpieza y mantenimiento técnico para proteger activos,
          optimizar instalaciones y responder a los desafíos de cada entorno.
        </p>
        </header>
      </div>
    </div>

    <!-- Divisor orgánico SVG: transición blanco → azul marino -->
    <div class="about__divider" aria-hidden="true">
      <svg viewBox="0 0 1440 140" preserveAspectRatio="none" focusable="false">
        <path d="M0 140V56C240 8 520 4 760 46s440 92 680 52v42Z" fill="#0D233A" />
      </svg>
    </div>
  </div>

  <!-- Bloque inferior: confianza y filosofía sobre azul marino -->
  <div class="about__bottom">
    <div class="container about__bottom-grid">
      <div class="about__figure" data-reveal-item style="--i: 0">
        <div
          class="about__carousel"
          data-about-carousel
          role="group"
          aria-roledescription="carrusel"
          aria-label="Galería de pilares corporativos"
        >
          {
            carousel.map((item) => (
              <button
                class:list={["about__card", item.position]}
                type="button"
                data-about-card
                aria-label={`Ver ${item.alt}`}
              >
                <Image
                  src={item.src}
                  alt={item.alt}
                  widths={[320, 520]}
                  sizes="(max-width: 900px) 60vw, 30vw"
                  loading="lazy"
                  decoding="async"
                  class="about__card-img"
                />
              </button>
            ))
          }
        </div>
      </div>

      <div class="about__philosophy">
        <div class="about__philosophy-head" data-reveal-item style="--i: 1">
          <p class="eyebrow about__eyebrow-dark">Nuestros pilares</p>
          <h3 class="about__subtitle">La excelencia está en cómo trabajamos</h3>
          <blockquote class="about__quote">
            La precisión no es un detalle. Es <span>el estándar de cada intervención</span>.
          </blockquote>
        </div>

        <ul class="about__pilares">
          {
            pilares.map((pillar, index) => (
              <li class="about__pilar" data-reveal-item style={`--i: ${index + 2}`}>
                <span class="about__pilar-icon" aria-hidden="true">
                  <Icon name={pillar.icon} size={20} />
                </span>
                <div class="about__pilar-body">
                  <h4>{pillar.title}</h4>
                  <p>{pillar.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // Revelado progresivo (galería, encabezado e inferiores) una sola vez.
  // Sin JS o con prefers-reduced-motion el contenido queda visible tal cual.
  const root = document.querySelector<HTMLElement>("[data-about-reveal]");

  if (
    root &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    root.setAttribute("data-reveal-ready", "");

    const reveal = (selector: string, stagger: number) => {
      const items = Array.from(root.querySelectorAll<HTMLElement>(selector));
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const target = entry.target as HTMLElement;
            target.style.transitionDelay = `${
              Number(getComputedStyle(target).getPropertyValue("--i")) * stagger
            }ms`;
            target.classList.add("is-visible");
            observer.unobserve(target);
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
      );
      for (const item of items) observer.observe(item);
    };

    reveal("[data-reveal-shot]", 90);
    reveal("[data-reveal-intro]", 0);

    const bottom = root.querySelector<HTMLElement>(".about__bottom");
    if (bottom) {
      const bottomObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const targets = Array.from(
              bottom.querySelectorAll<HTMLElement>("[data-reveal-item]"),
            );
            for (const target of targets) {
              target.style.transitionDelay = `${
                Number(getComputedStyle(target).getPropertyValue("--i")) * 110
              }ms`;
              target.classList.add("is-visible");
            }
            bottomObserver.disconnect();
          }
        },
        { threshold: 0.1, rootMargin: "0px 0px -12% 0px" },
      );
      bottomObserver.observe(bottom);
    }
  }

  // ------------------------------------------------------------------
  // Carrusel de pilares corporativos.
  // Tres tarjetas fijas en el DOM (no se reconstruyen). Guardamos el orden
  // de las tarjetas; al hacer clic en una lateral rotamos ese orden y
  // reasignamos las clases .pos-left / .pos-center / .pos-right.
  // ------------------------------------------------------------------
  const carouselRoot = document.querySelector<HTMLElement>("[data-about-carousel]");

  if (carouselRoot) {
    const cards = Array.from(
      carouselRoot.querySelectorAll<HTMLElement>("[data-about-card]"),
    );
    const POSITIONS = ["pos-left", "pos-center", "pos-right"] as const;

    // order[i] = índice de la tarjeta que ocupa la ranura i.
    // Ranuras: 0 = izquierda, 1 = centro, 2 = derecha.
    const initialOrder = cards.map((card) => {
      if (card.classList.contains("pos-left")) return 0;
      if (card.classList.contains("pos-right")) return 2;
      return 1;
    });
    const order = [...initialOrder];

    let animating = false;
    const reduceMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const apply = () => {
      cards.forEach((card) => card.classList.remove(...POSITIONS));
      order.forEach((cardIndex, slot) => {
        const card = cards[cardIndex];
        card.classList.add(POSITIONS[slot]);
        const isCenter = slot === 1;
        card.tabIndex = isCenter ? -1 : 0;
        card.setAttribute("aria-current", isCenter ? "true" : "false");
      });
    };

    // Rota el orden una ranura. direction 1 (clic a la derecha) y -1 (clic a
    // la izquierda) producen movimientos inversos y ciclan infinitamente.
    const rotate = (direction: 1 | -1) => {
      if (animating) return;

      const next = order.slice();
      for (let slot = 0; slot < next.length; slot++) {
        const from = (slot - direction + next.length) % next.length;
        next[slot] = order[from];
      }
      for (let i = 0; i < order.length; i++) order[i] = next[i];

      apply();

      if (!reduceMotion()) {
        animating = true;
        window.setTimeout(() => {
          animating = false;
        }, 420);
      }
    };

    cards.forEach((card, index) => {
      card.addEventListener("click", () => {
        const slot = order.indexOf(index);
        if (slot === 1) return; // La central no se mueve.
        // Clic en la derecha (slot 2) -> gira a la izquierda; izquierda -> derecha.
        rotate(slot === 2 ? 1 : -1);
        restartAuto();
      });
    });

    // Auto-rotación cada 2,5 s. Se pausa al interactuar y al ocultar la
    // pestaña, y se respeta prefers-reduced-motion.
    const AUTO_INTERVAL = 2500;
    let autoTimer: number | null = null;

    const stopAuto = () => {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer);
        autoTimer = null;
      }
    };

    const startAuto = () => {
      if (reduceMotion()) return;
      stopAuto();
      autoTimer = window.setInterval(() => rotate(1), AUTO_INTERVAL);
    };

    const restartAuto = () => {
      stopAuto();
      startAuto();
    };

    carouselRoot.addEventListener("mouseenter", stopAuto);
    carouselRoot.addEventListener("mouseleave", startAuto);
    carouselRoot.addEventListener("focusin", stopAuto);
    carouselRoot.addEventListener("focusout", startAuto);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopAuto();
      else startAuto();
    });

    apply();
    startAuto();
  }
</script>

<style>
  .about {
    --about-navy: #0d233a;
  }

  /* ----------------------------------------------------------------------
     Bloque superior: hero editorial
     ---------------------------------------------------------------------- */
  .about__top {
    position: relative;
    background: var(--white);
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .about__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: clamp(27rem, 56vw, 42rem);
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  /* Galería: posicionamiento absoluto sólo en desktop; en mobile pasa a flujo. */
  .about__gallery {
    display: contents;
  }

  .about__shot {
    margin: 0;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    position: relative;
  }

  .about__shot-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__shot-tag {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    color: var(--white);
    background: rgba(13, 35, 58, 0.62);
    backdrop-filter: blur(6px);
    border-radius: var(--radius-pill);
  }

  /* Titular: dominante, centrado. El ancho se limita para dejar carriles
     laterales libres para la galería flotante. */
  .about__intro {
    position: relative;
    z-index: 2;
    max-width: 46rem;
    text-align: center;
    margin-block: auto;
  }

  .about__headline {
    font-size: clamp(2.4rem, 5.4vw + 0.4rem, 5rem);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.02em;
    color: var(--about-navy);
    text-wrap: balance;
  }

  .about__headline span {
    color: var(--color-primary);
  }

  .about__lede {
    max-width: 40rem;
    margin: clamp(1.25rem, 2.5vw, 1.75rem) auto 0;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* ----------------------------------------------------------------------
     Divisor orgánico
     ---------------------------------------------------------------------- */
.about__divider {
    line-height: 0;
    margin-top: calc(-1 * clamp(1rem, 3vw, 2.5rem));
    margin-bottom: -2px; /* Margen negativo para solapar la sección de abajo */
    position: relative;
    z-index: 2;
}

.about__divider svg {
    display: block;
    width: 100%;
    height: clamp(70px, 9vw, 140px);
    /* Solo lo empujamos 1px hacia abajo y lo estiramos un poquito SOLO en la altura, dejando el ancho intacto a 100% */
    transform: translateY(1px) scaleY(1.02); 
    transform-origin: bottom; /* Asegura que crezca hacia abajo para tapar la línea */
}

  /* ----------------------------------------------------------------------
     Bloque inferior
     ---------------------------------------------------------------------- */
  .about__bottom {
    background: var(--about-navy);
    color: var(--color-on-dark);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .about__bottom-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 8vw, 7.5rem);
    align-items: start;
  }

  .about__figure {
    margin: 0;
    width: 100%;
    min-width: 0;
    max-width: 24rem;
  }

  /* ----------------------------------------------------------------------
     Carrusel de pilares: tres tarjetas verticales rectas.
     La central domina; las laterales quedan detrás, algo más chicas y
     oscurecidas. Sin rotaciones.
     ---------------------------------------------------------------------- */
  .about__carousel {
    margin-top:10%;
    position: relative;
    width: 100%;
    height: 450px;
    --card-w: 82%;
    --card-h: 90%;
    --side-shift: 46%;
  }

  .about__card {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--card-w);
    height: var(--card-h);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 24px;
    overflow: hidden;
    background: var(--brand-900);
    cursor: pointer;
    transform-origin: center center;
    transition:
      transform 420ms ease-in-out,
      filter 420ms ease-in-out,
      opacity 420ms ease-in-out;
    will-change: transform;
  }

  .about__card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Posiciones: izquierda / centro / derecha. z-index en la posición (no en
     el estado transitorio) para que la central siempre quede al frente. */
  .about__card.pos-left {
    transform: translateX(calc(-50% - var(--side-shift))) scale(0.85);
    filter: brightness(0.7) blur(3px);
    z-index: 1;
  }

  .about__card.pos-center {
    transform: translateX(-50%) scale(1);
    filter: brightness(1) blur(0);
    z-index: 3;
  }

  .about__card.pos-right {
    transform: translateX(calc(-50% + var(--side-shift))) scale(0.85);
    filter: brightness(0.7) blur(3px);
    z-index: 1;
  }

  .about__card:focus-visible {
    outline: 3px solid var(--accent-500);
    outline-offset: 3px;
  }

  .about__eyebrow-dark {
    color: var(--accent-400);
  }

  .about__eyebrow-dark::before {
    background: var(--accent-400);
  }

  .about__subtitle {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--white);
    text-wrap: balance;
  }

  .about__quote {
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    font-size: clamp(1.25rem, 1.6vw + 0.9rem, 1.75rem);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-on-dark);
    text-wrap: balance;
  }

  .about__quote span {
    color: var(--accent-400);
  }

  .about__pilares {
    display: grid;
    gap: 0;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
  }

  .about__pilar {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding-block: clamp(1rem, 2vw, 1.35rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .about__pilar:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .about__pilar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--brand-800);
    color: var(--white);
  }

  .about__pilar-body h4 {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--white);
  }

  .about__pilar-body p {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-on-dark-muted);
  }

  /* ----------------------------------------------------------------------
     Revelado progresivo
     ---------------------------------------------------------------------- */
  .about[data-reveal-ready] [data-reveal-shot],
  .about[data-reveal-ready] [data-reveal-intro],
  .about[data-reveal-ready] [data-reveal-item] {
    opacity: 0;
    translate: 0 1.5rem;
    transition:
      opacity 640ms var(--ease),
      translate 640ms var(--ease);
  }

  .about[data-reveal-ready] .is-visible {
    opacity: 1;
    translate: 0 0;
  }

  /* ----------------------------------------------------------------------
     Galería flotante anclada (sólo escritorio).
     .about__track es el riel de scroll; .about__stage es una capa sticky que
     queda anclada al viewport mientras se recorre el riel, manteniendo las
     cuatro imágenes (y el titular) visualmente fijos. Al agotarse el riel,
     la capa se libera y el bloque azul marino continúa su flujo normal.
     ---------------------------------------------------------------------- */
  @media (min-width: 901px) {
    .about__track {
      /* Riel de scroll: una pantalla visible + el recorrido del anclaje. */
      min-height: calc(100vh + 85vh);
      view-timeline-name: --about-rail;
      view-timeline-axis: block;
    }

    .about__stage {
      position: sticky;
      top: 0;
      min-height: 0;
      height: 100vh;
      height: 100svh;
      padding-block: 0;
      justify-content: center;
      overflow: hidden;
    }

    /* Anclaje a pantalla completa: el stage sticky (100vh) cubre el viewport
       durante toda la fase fija, sin asomar contenido de secciones contiguas. */
    .about__top {
      background: var(--white);
    }

    .about__gallery {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .about__shot {
      position: absolute;
      z-index: 1;
      pointer-events: auto;
    }

    /* Posición vertical con `top` (no `translate`): la propiedad `translate`
       está reservada por la animación de entrada del reveal. */
    .about__shot--a {
      left: 0;
      top: 12%;
      width: clamp(8rem, 12vw, 11rem);
      aspect-ratio: 3 / 4;
    }

    .about__shot--b {
      right: 0;
      top: 8%;
      width: clamp(9rem, 13vw, 12.5rem);
      aspect-ratio: 4 / 3;
    }

    .about__shot--c {
      left: 2%;
      bottom: 12%;
      width: clamp(9rem, 13vw, 12.5rem);
      aspect-ratio: 1 / 1;
    }

    .about__shot--d {
      right: 2%;
      bottom: 8%;
      width: clamp(8rem, 11.5vw, 11rem);
      aspect-ratio: 3 / 4;
    }

    .about__intro {
      margin: 0;
      z-index: 2;
    }
  }

  /* ----------------------------------------------------------------------
     Salida suave del anclaje (scroll-driven animations).
     Mientras el riel está fijo el contenido permanece; en el último tramo
     del recorrido el conjunto se desvanece y se aleja levemente, de modo
     que la liberación del sticky no sea un corte seco.
     Sin soporte (Firefox/Safari antiguos) la sección se ve igual, sin la
     transición extra: es una mejora progresiva.
     ---------------------------------------------------------------------- */
  @media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Las imágenes suben y se desvanecen a lo largo del anclaje.
         `forwards` (no `both`): antes del rango rige el revelado de entrada. */
      .about__top .about__shot {
        animation-name: about-shot-lift;
        animation-duration: auto;
        animation-fill-mode: forwards;
        animation-timing-function: linear;
        animation-timeline: --about-rail;
        animation-range-start: cover 36%;
        animation-range-end: cover 66%;
      }

      /* El titular se atenúa levemente sólo en el tramo final, antes de
         liberarse el sticky. */
      .about__top .about__intro {
        animation-name: about-rail-exit;
        animation-duration: auto;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: --about-rail;
        animation-range-start: cover 60%;
        animation-range-end: cover 70%;
      }
    }
  }

  @keyframes about-shot-lift {
    from {
      opacity: 1;
      translate: 0 0;
    }
    to {
      opacity: 0;
      translate: 0 -10px;
    }
  }

  @keyframes about-rail-exit {
    from {
      opacity: 1;
      scale: 1;
    }
    to {
      opacity: 0.45;
      scale: 0.965;
    }
  }

  /* ----------------------------------------------------------------------
     Tablet / móvil: galería en flujo, sin superposición
     ---------------------------------------------------------------------- */
  @media (max-width: 900px) {
    .about__stage {
      min-height: 0;
      padding-block: clamp(1.5rem, 4vw, 2.5rem);
    }

    .about__gallery {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
      width: 100%;
      margin-bottom: clamp(1.75rem, 5vw, 2.5rem);
    }

    .about__shot {
      border-radius: 20px;
    }

    .about__shot--a,
    .about__shot--c {
      aspect-ratio: 4 / 3;
    }

    .about__shot--b,
    .about__shot--d {
      aspect-ratio: 3 / 4;
    }

    /* El titular va primero en móvil para asegurar la jerarquía. */
    .about__intro {
      order: -1;
      margin-bottom: clamp(1.75rem, 5vw, 2.5rem);
    }

    .about__bottom-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 3rem);
    }

    .about__figure {
      max-width: 26rem;
      margin-inline: auto;
