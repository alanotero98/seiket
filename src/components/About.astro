---
import { Image } from "astro:assets";
import Section from "./ui/Section.astro";
import Icon from "./ui/Icon.astro";
import { about } from "../data/site";
import aboutIllustration from "../assets/cleaning.jpg";
---

<Section id="nosotros" tone="surface" labelledby="nosotros-title">
  <div class="about">
    <div class="about__visual">
      <Image
        src={aboutIllustration}
        alt="Ilustración de edificios corporativos que representan la gestión integral de instalaciones."
        width={640}
        height={480}
        loading="lazy"
        decoding="async"
        class="about__image"
      />
      <div class="about__badge">
        <span class="about__badge-icon"><Icon name="badge" size={20} /></span>
        <span>
          <strong>Calidad y mejora continua</strong>
          <small>Procesos documentados</small>
        </span>
      </div>
    </div>

    <div class="about__content">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2 id="nosotros-title">{about.title}</h2>
      {about.paragraphs.map((paragraph) => <p class="about__text">{paragraph}</p>)}

      <ul class="about__values">
        {
          about.values.map((value) => (
            <li class="about__value">
              <span class="icon-badge">
                <Icon name={value.icon} size={22} />
              </span>
              <div>
                <h3>{value.title}</h3>
                <p>{value.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .about__visual {
    position: relative;
  }

  .about__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .about__badge {
    position: absolute;
    bottom: -1rem;
    right: -1rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.85rem 1.1rem;
    background: var(--white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .about__badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--brand-50);
    color: var(--color-primary);
  }

  .about__badge span:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .about__badge strong {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  .about__badge small {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .about__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .about__values {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .about__value {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .about__value .icon-badge {
    width: 2.6rem;
    height: 2.6rem;
  }

  .about__value h3 {
    font-size: var(--text-base);
  }

  .about__value p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__visual {
      max-width: 32rem;
      margin-inline: auto;
    }

    .about__badge {
      right: 0.5rem;
      bottom: -1.25rem;
    }
  }
</style>
