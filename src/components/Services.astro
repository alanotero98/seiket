---
import { Image } from "astro:assets";
import Section from "./ui/Section.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import { services } from "../data/site";
---

<Section id="servicios" labelledby="servicios-title" tone="surface">
  <div class="section-head">
    <p class="eyebrow">Nuestros servicios</p>
    <h2 id="servicios-title">Soluciones integrales para cada entorno de trabajo.</h2>
    <p class="lead">
      Limpieza profesional, mantenimiento y gestión de instalaciones con personal
      capacitado y estándares de calidad exigentes.
    </p>
    
  </div>

  <ul class="svc-grid" role="list">
    {
      services.map((service) => (
        <li class="svc-grid__item">
          <article class="svc-card">
            <div class="svc-card__media">
              <Image
                src={service.image}
                alt={service.imageAlt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
              />
              <span class="svc-card__icon" aria-hidden="true">
                <Icon name={service.icon} size={24} />
              </span>
            </div>
            <div class="svc-card__body">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <a class="svc-card__link" href="#contacto">
                Más info
                <Icon name="arrow-right" size={16} class="svc-card__link-icon" />
              </a>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* ---------------------------------------------------------------------- */
  /* Encabezado — centrado                                                  */
  /* ---------------------------------------------------------------------- */
  .services__head-action {
    margin-top: var(--space-5);
  }

  /* ---------------------------------------------------------------------- */
  /* Grid de servicios                                                      */
  /* ---------------------------------------------------------------------- */
  .svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2rem);
    max-width: 72rem;
    margin-inline: auto;
  }

  /* Tablet: 4 columnas; con 5 tarjetas la última fila (1 item) se centra. */
  @media (min-width: 640px) {
    .svc-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .svc-grid__item {
      grid-column: span 2;
    }

    .svc-grid__item:nth-child(5):nth-last-child(1) {
      grid-column: 2 / span 2;
    }
  }

  /* Desktop: 6 columnas; con 5 tarjetas la segunda fila (2 items) se centra. */
  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .svc-grid__item {
      grid-column: span 2;
    }

    .svc-grid__item:nth-child(4):nth-last-child(2) {
      grid-column: 2 / span 2;
    }

    .svc-grid__item:nth-child(5):nth-last-child(1) {
      grid-column: 4 / span 2;
    }
  }

  .svc-grid__item {
    min-width: 0;
  }

  /* ---------------------------------------------------------------------- */
  /* Tarjeta: imagen arriba + contenido abajo, icono en la unión            */
  /* ---------------------------------------------------------------------- */
  .svc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* overflow:hidden recorta la imagen en las esquinas redondeadas; el icono
       no se ve afectado porque queda dentro de los límites de la tarjeta. */
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition),
      box-shadow var(--transition),
      border-color var(--transition);
  }

  .svc-card:hover,
  .svc-card:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--brand-200);
  }

  .svc-card__media {
    position: relative;
    /* La imagen va fuera del flujo para que su proporción intrínseca nunca
       altere la altura del contenedor (p. ej. fotos cuadradas). */
    flex: none;
    aspect-ratio: 4 / 3;
    background: var(--brand-100);
  }

  .svc-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Cuadrado azul superpuesto a la unión imagen/contenido. */
  .svc-card__icon {
    position: absolute;
    left: var(--space-5);
    bottom: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    transform: translateY(50%);
    background: var(--color-primary);
    color: var(--white);
  }

  .svc-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-3);
    /* El padding superior deja libre la mitad inferior del icono. */
    padding: clamp(2.4rem, 3vw, 2.75rem) clamp(1.35rem, 2.5vw, 1.75rem)
      clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .svc-card h3 {
    font-size: var(--text-xl);
    color: var(--ink-900);
  }

  .svc-card p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .svc-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-primary);
  }

  .svc-card__link:hover {
    color: var(--color-primary-hover);
  }

  .svc-card__link :global(.svc-card__link-icon) {
    transition: transform var(--transition);
  }

  .svc-card__link:hover :global(.svc-card__link-icon),
  .svc-card__link:focus-visible :global(.svc-card__link-icon) {
    transform: translateX(3px);
  }
</style>
